{
  "name": "TankModbus",
  "protocol": "modbus-tcp",
  "modbusSlaveConfig": {
    "enabled": true,
    "transports": [
      "tcp"
    ],
    "networkInterface": "0.0.0.0",
    "port": 5020,
    "bufferMapping": {
      "coils": {
        "qxBits": 8,
        "mxBits": 8
      },
      "holdingRegisters": {
        "qwCount": 2
      }
    }
  }
}